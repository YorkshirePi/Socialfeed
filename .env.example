# Comma-separated terms to search for across every platform.
# Usually your company name plus common variations / handles.
SEARCH_TERMS="Acme Inc,@acme,#acme"

# How many results to request from each source.
PER_SOURCE_LIMIT=25

# Web server port
PORT=3000

# --- Bluesky (free; uses public AppView search if no creds provided) ---
# Optional. Authenticated search returns more results and is more reliable.
# Create an App Password at https://bsky.app/settings/app-passwords
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# --- Twitter / X (paid) ---
# Requires a Basic-tier or higher Bearer Token.
# https://developer.x.com -> Project -> Keys -> Bearer Token
TWITTER_BEARER_TOKEN=

# --- LinkedIn (restricted) ---
# LinkedIn does not expose a public post-search API. To pull mentions you need
# a Marketing Developer Platform partner app with the r_organization_social
# scope (returns mentions of pages you own only). Leave blank to disable.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_URN=

# --- Instagram (restricted) ---
# Instagram Graph API only supports mention-tracking for Business/Creator
# accounts you own, via /{ig-user-id}/tags. Leave blank to disable.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
